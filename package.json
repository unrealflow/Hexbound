{
  "name": "hexbound",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node scripts/start.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "refs:fetch": "node scripts/fetch-refs.mjs",
    "shots": "node scripts/capture-shots.mjs",
    "shots:iter": "node scripts/iter-shot.mjs",
    "corner:check": "node scripts/corner-check.mjs",
    "hole:check": "node scripts/hole-check.mjs",
    "disp:weld": "node scripts/disp-weld-check.mjs",
    "pick:check": "node scripts/pick-check.mjs",
    "crack:metric": "npx tsx scripts/crack-metric.ts",
    "profile:check": "npx tsx scripts/profile-probe.ts",
    "glsl:check": "node scripts/check-glsl.mjs",
    "p0:check": "npm run glsl:check && npx tsc --noEmit && npm run crack:metric && npm run profile:check && npm run corner:check && npm run hole:check && npm run disp:weld",
    "verify": "npm run p0:check && npm run pick:check",
    "tex:gen": "node scripts/gen-detail-tex.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@babylonjs/core": "^9.26.1"
  }
}
